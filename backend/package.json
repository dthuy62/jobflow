{
  "name": "@jobflow/backend",
  "version": "0.0.0",
  "private": true,
  "description": "The hosted JobFlow API and workers.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "npm run build -w @jobflow/contract",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "prebuild": "npm run build -w @jobflow/contract",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build -w @jobflow/contract",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@jobflow/contract": "file:../packages/contract",
    "fastify": "^5.12.7",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
