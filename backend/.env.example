# Development values only. Real values are injected at runtime, never committed.
JOBFLOW_ENV=development
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgres://jobflow_app:dev-only-app@127.0.0.1:5432/jobflow
DATABASE_MIGRATION_URL=postgres://jobflow_owner:dev-only-owner@127.0.0.1:5432/jobflow
FIREBASE_PROJECT_ID=demo-jobflow
FIREBASE_API_KEY=demo-key
# Number of trusted proxies in front of the API. Never set this higher than the real count.
TRUST_PROXY=0
