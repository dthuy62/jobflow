{
  "name": "@jobflow/contract",
  "version": "0.0.0",
  "private": true,
  "description": "The hosted JobFlow API contract: Zod schemas, operations and the OpenAPI generator.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
