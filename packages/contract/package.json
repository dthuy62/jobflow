    "gen": "tsx scripts/gen-openapi.ts",
    "mock:smoke": "tsx scripts/mock-smoke.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
