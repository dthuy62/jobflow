<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing here should move to another device: the database is a per-user cache the API can rebuild, and preferences hold
     Firebase's session and whether this install had its guest. allowBackup="false" stops cloud backup, but some
     manufacturers' device-to-device transfer ignores it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
