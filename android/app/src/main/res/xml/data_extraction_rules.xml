<?xml version="1.0" encoding="utf-8"?>
<!-- The database holds per-user feed data, and the API can rebuild it, so it never leaves the device. allowBackup="false"
     stops cloud backup, but some manufacturers' device-to-device transfer ignores it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
