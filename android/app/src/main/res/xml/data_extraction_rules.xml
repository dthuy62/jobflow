<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing here should move to another device: the database is a per-user cache the API can rebuild, preferences hold
     Firebase's session, and DataStore holds auth's own state, including a guest's token. allowBackup="false" stops cloud
     backup, but some manufacturers' device-to-device transfer ignores it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
