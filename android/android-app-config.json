{
  "module": "app",
  "dimension": "environment",
  "flavors": {
    "dev": {
      "applicationIdSuffix": ".dev",
      "appName": "[DEV] JobFlow",
      "buildConfigFields": {
        "API_BASE_URL": "http://10.0.2.2:4010"
      }
    },
    "prod": {
      "applicationIdSuffix": "",
      "appName": "JobFlow",
      "buildConfigFields": {
        "API_BASE_URL": "https://api.jobflow.invalid"
      }
    }
  },
  "networkSecurity": {
    "enabled": true,
    "targetFlavors": [
      "dev"
    ]
  },
  "packageName": {
    "applicationId": "me.dthuy.jobflow",
    "syncSourcePackages": true
  },
  "firebase": {
    "enabled": true,
    "mode": "single",
    "project": "jobflow-app-dev",
    "createApps": true,
    "flavors": {
      "dev": {
        "project": ""
      },
      "prod": {
        "project": ""
      }
    }
  },
  "assets": {
    "enabled": false,
    "sourceIcon": "",
    "types": [
      "app-icons"
    ],
    "appIcons": {
      "image": "",
      "backgroundColor": "#FFFFFF",
      "monochromeImage": ""
    },
    "splashScreens": {
      "image": "",
      "backgroundColor": "#FFFFFF",
      "darkImage": "",
      "darkBackgroundColor": ""
    },
    "generateLauncherIcon": true,
    "generateAdaptiveIcon": true,
    "generateSplashIcon": true,
    "generateNotificationIcon": true
  }
}
